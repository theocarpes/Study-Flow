# O EAS usa este arquivo no lugar do .gitignore para montar o pacote de build.
# firebase.js fica fora do GitHub, mas precisa ser enviado ao build privado,
# pois o aplicativo importa a configuração local do Firebase.

# Não envie metadados do Git
.git/

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
